# Paperless-ngx: base URL and an API token (Profile -> API auth token)
PAPERLESS_URL=http://paperless:8000
PAPERLESS_TOKEN=

# Ollama: URL and model (small instruct models work; qwen3 4B is a good start on CPU)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b

# Language of your documents: the model writes titles in it
DOC_LANGUAGE=English

# Tags added by the classifier
TAG_REVIEW=AI to review
TAG_SEEN=AI seen

# What to fill in
SET_TYPE=true
SET_TITLE=true
SET_CORRESPONDENT=true

# Limits for one run: stop at this local time and/or after N documents
STOP_AT=06:30
MAX_DOCS=400
MAX_CHARS=3000
NUM_CTX=4096

# Empty = run once and exit (cron/systemd). "HH:MM" = stay up and run every day at that time.
RUN_AT=02:00
TZ=Europe/London
